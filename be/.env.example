NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
WRITE_API_KEY=<SET_A_STRONG_RANDOM_KEY_FOR_WRITE_ENDPOINTS>
ENABLE_DEMO_MINT=false

# Autonomous orchestration loop
ORCHESTRATOR_ENABLED=false
ORCHESTRATOR_INTERVAL_MS=300000
DRIFT_THRESHOLD_BPS=300
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
OPENROUTER_MODEL=openai/gpt-4o-mini
TX_CONFIRMATIONS=1
TX_TIMEOUT_MS=180000
RPC_TIMEOUT_MS=10000
RPC_RETRY_COUNT=3
RPC_RETRY_DELAY_MS=150

MANTLE_CHAIN_ID=5003
MANTLE_CHAIN_NAME=Mantle Sepolia
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_EXPLORER_URL=https://explorer.sepolia.mantle.xyz

OPERATOR_PRIVATE_KEY=0x<OPERATOR_PRIVATE_KEY>

VAULT_ADDRESS=0x<VAULT_ADDRESS>
AGENT_ID=1
AGENT_REGISTRY_ADDRESS=0x<AGENT_REGISTRY_ADDRESS>
STRATEGY_REGISTRY_ADDRESS=0x<STRATEGY_REGISTRY_ADDRESS>
EXCHANGE_ADDRESS=0x<EXCHANGE_ADDRESS>

MOCK_USDY_ADDRESS=0x<MOCK_USDY_ADDRESS>
MOCK_METH_ADDRESS=0x<MOCK_METH_ADDRESS>
MOCK_FBTC_ADDRESS=0x<MOCK_FBTC_ADDRESS>
MOCK_MI4_ADDRESS=0x<MOCK_MI4_ADDRESS>

USDY_IDLE_ADAPTER_ADDRESS=0x<USDY_IDLE_ADAPTER_ADDRESS>
METH_DEFI_ADAPTER_ADDRESS=0x<METH_DEFI_ADAPTER_ADDRESS>
FBTC_CEFI_ADAPTER_ADDRESS=0x<FBTC_CEFI_ADAPTER_ADDRESS>
MI4_DEFI_ADAPTER_ADDRESS=0x<MI4_DEFI_ADAPTER_ADDRESS>
